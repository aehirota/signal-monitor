# LLM
ANTHROPIC_API_KEY=

# Search sources (primary per signal type)
EXA_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Email delivery
RESEND_API_KEY=
DIGEST_FROM_EMAIL=signal-monitor@yourdomain.com
DIGEST_TO_EMAIL=you@yourdomain.com

# Optional — observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=signal-monitor

# Optional — concurrency cap for Anthropic API calls.
# Default 2 fits Tier 1 (30k Sonnet / 50k Haiku tokens/min).
# Bump to 4-6 after upgrading to Tier 2+.
ANTHROPIC_MAX_CONCURRENT=2
